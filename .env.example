# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

# 세션 쿠키 서명 키. 운영에서는 반드시 설정한다.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite DB 파일 경로
DB_PATH=actors.db

# HTTPS로 서비스할 때 true
SESSION_HTTPS_ONLY=false

# LibreOffice 실행 파일 경로 (PPT 컴카드 미리보기용). 비우면 자동으로 찾는다.
SOFFICE_PATH=
